{
 "manifest_version": 2,
 "name": "Spider Animator",
 "version": "1.0",
 "description": "A spider walking across the screen",
 "browser_specific_settings": {
"gecko": {
"id": "spider_animator@example.com",
"strict_min_version": "140.0",
"data_collection_permissions": {
"required": ["none"]
}
}
 },
"permissions": ["storage"],
"browser_action": {
"default_popup": "popup.html",
"default_icon": {
"16": "icons/spider16.png",
"32": "icons/spider32.png",
"48": "icons/spider48.png",
"128": "icons/spider128.png"
}
},
"icons": {
"16": "icons/spider16.png",
"32": "icons/spider32.png",
"48": "icons/spider48.png",
"128": "icons/spider128.png"
},
"content_scripts": [
{
 "matches": ["<all_urls>"],
    "js": ["content.js"]
}
],
"web_accessible_resources": [
"assets/spider.gif",
"assets/left-web.png",
"assets/right-web.png"
]
}